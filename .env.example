# --- Server ---------------------------------------------------------------
# Bearer token for the REST API. Leave empty to have one generated and saved in ~/.openring/.env
# (/data/.env in Docker); the dashboard shows it under Settings. Or set your own long random value.
# Without a key, the API only answers the computer it runs on. Example values like "change-me" are refused.
OPENRING_API_KEY=
# Dashboard password. Leave empty to choose it at http://localhost on the first visit; set it when
# nobody opens the dashboard on the server itself (Docker, VPS). Reset: openring --reset-password
OPENRING_PASSWORD=
# Public https URL Twilio can reach (e.g. from `ngrok http 8000`)
PUBLIC_URL=https://your-subdomain.ngrok-free.app
# Optional: assistant used when a number has no assistant attached
DEFAULT_ASSISTANT_ID=

# --- Telephony (Twilio) ----------------------------------------------------
TWILIO_ACCOUNT_SID=
# Required to answer calls: it proves each webhook really comes from Twilio
TWILIO_AUTH_TOKEN=
# false skips that check (local tests only)
VALIDATE_TWILIO_SIGNATURE=true

# --- Telephony (Genesys Cloud, beta) -----------------------------------------
# The credentials of your Audio Connector integration. You choose both (the Providers page can generate
# them) and paste the same into Genesys. The client secret is base64.
GENESYS_API_KEY=
GENESYS_CLIENT_SECRET=

# --- Speech-to-text --------------------------------------------------------
# Deepgram gives US$200 of free credit to new accounts
DEEPGRAM_API_KEY=

# --- LLM (any OpenAI-compatible provider) ---------------------------------
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Requests to OpenRouter name OpenRing (for its app rankings). Set to false to leave that out.
# OPENRING_ATTRIBUTION=false
DEEPSEEK_API_KEY=
# OmniRoute (free gateway to 150+ free model providers)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# --- Plivo, Vonage and Telnyx's outgoing calls (or connect them on the Providers page) ---
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# VONAGE_APPLICATION_ID=
# The file Vonage lets you download when you create the application:
# VONAGE_PRIVATE_KEY=/path/to/private.key
# VONAGE_SIGNATURE_SECRET=
# TELNYX_APPLICATION_ID=

# --- SIP trunks ---------------------------------------------------------------
# Nothing listens until a trunk is saved. The carrier must reach these UDP ports.
# SIP_PORT=5060
# SIP_RTP_PORTS=40000-40999
# The public address, when this computer doesn't have it (behind a NAT):
# SIP_PUBLIC_IP=203.0.113.10

# --- Text-to-speech ---------------------------------------------------------
# Leave empty to use Kokoro (free, runs locally)
ELEVENLABS_API_KEY=
